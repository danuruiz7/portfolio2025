---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import { portfolio } from "../../data/portfolio";

export function getStaticPaths() {
  return portfolio.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const projectsPage = portfolio.pages.projects;
const hasRepo = (repo?: string) => repo && repo.length > 0;
const isRepoAvailable = hasRepo(project.links.repo);
---

<Layout title={project.seoTitle} description={project.seoDescription}>
  <article class="py-16">
    <a
      href="/proyectos"
      class="inline-flex rounded-lg border border-slate-800 px-4 py-2 text-sm text-slate-300 transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
    >
      {projectsPage.backLabel}
    </a>

    <div class="mt-8 grid gap-10 lg:grid-cols-[1.2fr_0.8fr]">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-300">{projectsPage.studyEyebrow}</p>
        <h1 class="mt-4 text-4xl font-bold text-white md:text-5xl">{project.title}</h1>
        <p class="mt-6 text-lg leading-8 text-slate-400">{project.description}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          {project.tags.map((tag) => (
            <span class="rounded-full border border-indigo-500/20 bg-indigo-500/10 px-3 py-1 text-sm text-indigo-300">
              {tag}
            </span>
          ))}
        </div>
      </div>

      <div class="rounded-3xl border border-slate-800 bg-slate-900/40 p-6">
        {project.image && (
          <img
            src={project.image}
            alt={project.title}
            class="h-full w-full rounded-2xl object-cover"
          />
        )}
      </div>
    </div>
  </article>

  <section class="grid gap-6 pb-20 lg:grid-cols-3">
    <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-8">
      <h2 class="text-xl font-semibold text-white">{projectsPage.challengeTitle}</h2>
      <p class="mt-4 leading-7 text-slate-400">{project.challenge}</p>
    </div>
    <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-8">
      <h2 class="text-xl font-semibold text-white">{projectsPage.solutionTitle}</h2>
      <p class="mt-4 leading-7 text-slate-400">{project.solution}</p>
    </div>
    <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-8">
      <h2 class="text-xl font-semibold text-white">{projectsPage.outcomeTitle}</h2>
      <p class="mt-4 leading-7 text-slate-400">{project.outcome}</p>
    </div>
  </section>

  <section class="pb-20">
    <div class="grid gap-6 lg:grid-cols-[1fr_0.8fr]">
      <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-8">
        <h2 class="text-2xl font-semibold text-white">{projectsPage.deliverablesTitle}</h2>
        <ul class="mt-6 space-y-3 text-slate-300">
          {project.deliverables.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-indigo-400"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-8">
        <h2 class="text-2xl font-semibold text-white">{projectsPage.linksTitle}</h2>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={project.links.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
          >
            {projectsPage.demoLabel}
          </a>
          
          {isRepoAvailable ? (
            <a
              href={project.links.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg border border-slate-700 px-4 py-2 text-sm text-slate-200 transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
            >
              {projectsPage.repoLabel}
            </a>
          ) : (
            <div class="relative group/tooltip">
              <button 
                disabled
                class="rounded-lg border border-slate-700 px-4 py-2 text-sm text-slate-500 cursor-not-allowed"
                title={projectsPage.noRepoTooltip}
              >
                {projectsPage.repoLabel}
              </button>
              <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 text-xs text-white bg-slate-800 rounded opacity-0 group-hover/tooltip:opacity-100 transition-opacity pointer-events-none whitespace-nowrap z-50">
                {projectsPage.noRepoTooltip}
              </div>
            </div>
          )}
        </div>

        <div class="mt-8">
          <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-300">{projectsPage.keywordsTitle}</h3>
          <ul class="mt-4 space-y-2 text-sm text-slate-400">
            {project.keywords.map((keyword) => (
              <li>{keyword}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>