---
import Layout from "../layouts/Layout.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Stack from "../components/Stack.astro";
import Footer from "../components/Footer.astro";
import { portfolio } from "../data/portfolio";

const { about, pages } = portfolio;
---

<Layout
  title={pages.about.title}
  description={pages.about.description}
>
  <section class="py-16">
    <div class="max-w-4xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-300">{pages.about.eyebrow}</p>
      <h1 class="mt-4 text-4xl font-bold text-white md:text-5xl">
        {pages.about.heading}
      </h1>
      <p class="mt-6 text-lg leading-8 text-slate-400">
        {about.longDescription}
      </p>
    </div>
  </section>
  <About />
  <Experience />
  <Stack />
  <Footer />
</Layout>
