---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import privacyData from "../data/privacy.json";
---

<Layout title={privacyData.title} description={privacyData.description}>
  <section class="py-16">
    <div class="mx-auto max-w-4xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-300">
        {privacyData.lastUpdatedLabel}: {privacyData.lastUpdated}
      </p>
      <h1 class="mt-4 text-4xl font-bold text-white md:text-5xl">
        {privacyData.heading}
      </h1>
      <p class="mt-6 text-lg leading-8 text-slate-400">
        {privacyData.intro}
      </p>
    </div>
  </section>

  <section class="pb-20">
    <div class="mx-auto max-w-4xl space-y-8">
      {privacyData.sections.map((section) => (
        <article class="rounded-2xl border border-slate-800 bg-slate-900/40 p-8">
          <h2 class="text-2xl font-semibold text-white">{section.title}</h2>

          <div class="mt-4 space-y-4 text-slate-400 leading-7">
            {section.paragraphs?.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          {section.items && (
            <ul class="mt-5 space-y-3 text-slate-300">
              {section.items.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-2 h-1.5 w-1.5 rounded-full bg-indigo-400"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          )}

          {section.closing && (
            <p class="mt-5 leading-7 text-slate-400">{section.closing}</p>
          )}

          {section.contactEmail && (
            <p class="mt-5">
              <a
                href={`mailto:${section.contactEmail}`}
                class="text-indigo-300 underline underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 rounded-sm"
              >
                {section.contactEmail}
              </a>
            </p>
          )}
        </article>
      ))}
    </div>
  </section>

  <Footer />
</Layout>
