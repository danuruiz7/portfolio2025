---
import { portfolio } from "../data/portfolio";
import { ChevronDown } from "lucide-react";

const { faq, pages } = portfolio;
---

<section class="py-20 reveal-on-scroll">
  <div class="mx-auto max-w-4xl">
    <h2 class="text-3xl font-bold text-white">{pages.home.faqTitle}</h2>
    <div class="mt-10 space-y-4">
      {faq.map((item, index) => (
        <details class="group rounded-2xl border border-slate-800 bg-slate-900/40 transition-colors" name={`faq-${index}`}>
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none p-6 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 rounded-2xl">
            <span class="text-lg font-semibold text-white">{item.question}</span>
            <ChevronDown className="w-5 h-5 shrink-0 text-slate-400 transition-transform group-open:rotate-180" />
          </summary>
          <div class="overflow-hidden transition-all duration-300">
            <p class="px-6 pb-6 leading-7 text-slate-400">{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>