---
import { portfolio } from "../data/portfolio";

const { faq, pages } = portfolio;
---

<section class="py-20 reveal-on-scroll">
  <div class="mx-auto max-w-4xl">
    <h2 class="text-3xl font-bold text-white">{pages.home.faqTitle}</h2>
    <div class="mt-10 space-y-4">
      {faq.map((item) => (
        <details class="rounded-2xl border border-slate-800 bg-slate-900/40 p-6">
          <summary class="cursor-pointer list-none text-lg font-semibold text-white">
            {item.question}
          </summary>
          <p class="mt-4 leading-7 text-slate-400">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
