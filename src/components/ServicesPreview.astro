---
import { Cpu, ArrowUpRight } from "lucide-react";
import { portfolio } from "../data/portfolio";

const { services, pages } = portfolio;
---

<section class="py-20 reveal-on-scroll">
  <div class="flex flex-col gap-10">
    <div class="flex items-end justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="p-2.5 rounded-lg bg-indigo-500/10 text-indigo-400 ring-1 ring-indigo-500/20">
          <Cpu className="w-5 h-5" />
        </div>
        <div>
          <h2 class="text-3xl font-bold text-white">{pages.home.servicesTitle}</h2>
          <p class="mt-2 max-w-2xl text-slate-400">
            {pages.home.servicesIntro}
          </p>
        </div>
      </div>

      <a
        href="/servicios"
        class="hidden sm:inline-flex items-center gap-2 rounded-lg border border-slate-800 px-4 py-2 text-sm text-slate-200 transition-colors hover:border-indigo-500/40 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
      >
        {pages.home.servicesCtaLabel}
        <ArrowUpRight className="w-4 h-4" />
      </a>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {services.map((service) => (
        <article class="rounded-2xl border border-slate-800 bg-slate-900/40 p-6 transition-colors hover:border-indigo-500/40">
          <p class="text-sm font-medium text-indigo-300">{service.summary}</p>
          <h3 class="mt-3 text-xl font-semibold text-white">{service.title}</h3>
          <p class="mt-3 text-sm leading-7 text-slate-400">{service.description}</p>
          <ul class="mt-5 space-y-2 text-sm text-slate-300">
            {service.deliverables.slice(0, 3).map((item) => (
              <li class="flex items-start gap-2">
                <span class="mt-2 h-1.5 w-1.5 rounded-full bg-indigo-400"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
